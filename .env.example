# -----------------------------------------------------------------------------
# .env.example : checklist of every value the workflows need
#
# n8n keeps credentials in its own encrypted store, and n8n 2.x blocks $env in
# Code nodes, so these values are NOT read from a .env file at runtime. This
# file is the single list of what you must supply and where it goes.
# Never commit a real .env (it is git-ignored).
# -----------------------------------------------------------------------------

# --- Shared ------------------------------------------------------------------
# Bot token from @BotFather -> n8n credential "Telegram Bot"
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Your numeric Telegram user ID (message @userinfobot) -> pasted into the
# Telegram nodes / "Settings" node of each workflow
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# Google service account JSON key -> n8n credential "Google Service Account".
# Share every Google Sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Ollama base URL as seen FROM the n8n container (n8n in Docker, Ollama on host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Timezone for schedule triggers (set on the n8n container)
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# --- job-search-pipeline -------------------------------------------------------
# Spreadsheet with tabs: Vistos, Pipeline
JOB_SEARCH_SHEET_ID=YOUR_GOOGLE_SHEET_ID

# --- expense-habit-bot ---------------------------------------------------------
# Spreadsheet with tabs: Gastos, Habitos_Log, Config_Habitos, Ultimo_Registro
EXPENSE_BOT_SHEET_ID=YOUR_GOOGLE_SHEET_ID
# Random string -> n8n credential "iOS Shortcut Header Auth" (Header Auth),
# sent by the iOS Shortcut in a request header
IOS_SHORTCUT_WEBHOOK_TOKEN=YOUR_RANDOM_TOKEN

# --- job-search-pipeline: inbox-triage workflow ----------------------------------
# Gmail OAuth2 -> n8n credential "Gmail Account" (read access to the inbox to triage)
# The Telegram bot and chat ID from the Shared section receive the urgent-mail alerts.

# --- lead-gen-pipeline ---------------------------------------------------------
# Spreadsheet with one tab named "Leads" (see lead-gen-pipeline/sheet-template/Leads.csv)
LEADS_SHEET_ID=YOUR_GOOGLE_SHEET_ID
# Contact finder: set the provider in the "Config (outreach)" node. Hunter OR Apollo (or both).
# Hunter API key -> n8n credential "Hunter API"
HUNTER_API_KEY=YOUR_HUNTER_API_KEY
# Apollo API key -> n8n credential "Apollo API" (Header Auth, header name: x-api-key)
APOLLO_API_KEY=YOUR_APOLLO_API_KEY
# Adzuna: the app key goes in the credential "Adzuna API Key" (Query Auth, parameter name: app_key);
# the app id is typed into the app_id parameter of the "Adzuna search" node
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
# Random string -> n8n credential "Lead Intake Header Auth" (Header Auth) on the intake webhook
LEAD_WEBHOOK_TOKEN=YOUR_RANDOM_TOKEN
# Gmail OAuth2 for the sending account -> n8n credential "Gmail Account"
# Your own address, where review drafts, follow-up drafts and the weekly report arrive
# (set in the sender.review_email field of each "Config (...)" node)
REVIEW_EMAIL=you@example.com
